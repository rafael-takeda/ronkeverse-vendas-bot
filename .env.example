# A URL do webhook do Discord. E SENHA: quem tiver posta no canal com a cara do
# bot. Nunca comitar, nunca mandar em chat.
#
# ACEITA VARIOS, separados por virgula ou espaco -- um por servidor. A venda e
# anunciada em todos, com a mesma leitura da cadeia e o mesmo ponteiro de blocos.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/AAA, https://discord.com/api/webhooks/BBB

# So em producao. Estado entre execucoes (Vercel KV / Upstash). Sem os dois, o
# bot cai pro arquivo local -- que em serverless NAO persiste e faz repetir.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A Vercel manda isso nos crons dela. Protege a rota de quem achar a URL.
CRON_SECRET=

# Opcionais.
# RONIN_RPC=https://api.roninchain.com/rpc
# CONTRATO=0x810B6d1374ac7BA0E83612E7d49F49A13f1de019
